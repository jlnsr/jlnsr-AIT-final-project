<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<canvas id="myChart" width="400" height="200"></canvas>
<script>
    const toLog = document.querySelector('.to-ordersLog')
    toLog.addEventListener('click', function() {
        window.location.href = '/ordersLog'
    })
    const chart = document.getElementById('myChart');

    // Reference for the following code:https://www.chartjs.org/docs/latest/getting-started/usage.html
    new Chart(chart, {
        type: 'bar',
        data: {
        labels: ['Item 1', 'Item 2', 'Item 3', 'Item 4', 'Item 5', 'Item 6'],
        datasets: [{
            label: 'Number of times item was ordered',
            data: [7,5,6,12,10,3],
            borderWidth: 2,
        }]
        },
        options: { responsive: true }
    });
</script>