<h1>In order to view business logs and analytics, you must login as a registered staff</h1>
{{#if authFailed}}
    <p class="warning">These are not valid employee credentials</p>
{{/if}}
<form action="/staffAuth" method="POST">
    <input type="text" name="firstName">
    <input type="text" name="lastName">
    <input type="text" name="employeeId">
    <input type="text" name="password">
    <input type="submit">
</form>