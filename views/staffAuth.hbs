<h1>In order to view business logs and analytics, you must login as a registered staff</h1>
{{#if authFailed}}
    <p class="warning">These are not valid employee credentials</p>
{{/if}}
<form class="auth-form" action="/staffAuth" method="POST">
    <input type="text" name="firstName" placeholder="First name">
    <input type="text" name="lastName" placeholder="Last name">
    <input type="text" name="employeeId" placeholder="Employee Id">
    <input type="text" name="password" placeholder="Password">
    <input type="submit">
</form>